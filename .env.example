# Copy to .env.local and fill in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (local) or the Dashboard webhook endpoint (prod)
# Endpoint events: checkout.session.completed, checkout.session.expired, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...

# Long random string; used for /api/subscribers and /api/admin/inventory
ADMIN_TOKEN=change-me

# Optional; defaults to ./data/store.db
# DATABASE_PATH=/var/lib/store/store.db

# Signup notifications. Any SMTP provider works (Resend, Postmark, Gmail app password, Zoho, Fastmail...).
# If SMTP_HOST is empty, emails are skipped and a warning is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender; must be an address/domain your SMTP provider allows you to send from
MAIL_FROM="Your Store <no-reply@yourdomain.com>"
# Central inbox that receives a message for every new signup
NOTIFY_EMAIL=you@yourdomain.com
